{
    // -------------------------------------------------------------------------
    // Global configuration
    // -------------------------------------------------------------------------

    "layer": "top",

    "position": "top",

    // If height property would be not present, it'd be calculated dynamically
    "height": 27,

    "modules-left": [
      "hyprland/workspaces#taskbar",
    ],
    "modules-right": [
        "hyprland/submap",
        "group/mpris",
        "hyprland/workspaces#picker",
        "battery",
        "custom/spacer",
        "tray",
        "custom/spacer",
        "group/performance",
        "custom/spacer",
        "group/worldclock",
        "custom/fullscreen",
    ],
    // -------------------------------------------------------------------------
    // Modules
    // -------------------------------------------------------------------------
    "group/worldclock": {
      "orientation": "inherit",
      "drawer": {
          "transition-duration": 500,
          "click-to-reveal": true,
          "transition-left-to-right": false,
      },
      "modules": [
        "clock",
        "clock#nl",
        "custom/spacer",
        "clock#uk",
        "custom/spacer",
        "clock#us",
        "custom/spacer",
      ]
    },
    "group/performance": {
      "orientation": "inherit",
      "modules": [
        "cpu",
        "cpu#icon",
        "memory",
        "memory#icon",
      ]
    },
    "group/mpris": {
      "orientation": "inherit",
      "modules": [
        "mpris#statusplay",
        "mpris#icon",
        "mpris#name",
      ]
    },
    "hyprland/workspaces#picker": {
      "move-to-monitor": true,
      "all-outputs": true
    },
    "hyprland/workspaces#taskbar": {
        "format": "{icon}:{windows}",
        "format-window-separator": " ",
        "active-only":true,
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon} {title:.22}",
            "icon-size": 18,
            "on-click-window": "${HOME}/.config/waybar/scripts/focus-window.sh {address} {button}"
        }
    },

    "hyprland/window": {
      "move-to-monitor": true,
      "max-length": 30,
      "seperate-outputs": true,
      "icon-size": 18,
      "icon": true
    },
    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        // Connected to AC
        "format": "  {icon}  {capacity}%", // Icon: bolt
        // Not connected to AC
        "format-discharging": "{icon}  {capacity}%",
        "format-icons": [
            "", // Icon: battery-full
            "", // Icon: battery-three-quarters
            "", // Icon: battery-half
            "", // Icon: battery-quarter
            ""  // Icon: battery-empty
        ],
        "tooltip": true
    },
    "custom/spacer": {
      "format": "|",
      "tooltip": false
    },
    "mpris#icon": {
      "format": "{player_icon}",
      "player-icons": {
        "default": "󰎆 ",
        "spotify": " ",
        "brave": " ",
        "firefox": " ",
        "chromium": " ",
      },
    },
    "mpris#statusplay": {
      "format": "{status_icon}",
      "status-icons": {
        "paused": "⏸",
        "playing": "",
        "stopped": "󰓛"
      },
    },
    "mpris#name": {
      "format": "{dynamic}",
      "dynamic-order": ["title","artist"],
      "title-len": 25,
      "dynamic-len": 28,
      "dynamic-importance-order": ["title", "artist"],
    },
    "clock#us": {
      "timezone":"US/Central",
      "interval": 1,
      "format": "US, {:%a %I:%M:%S%p}",
      "tooltip-format": "{:%H:%M:%S, %A, %e %B %Y}"
    },
    "clock#uk": {
      "timezone":"Europe/London",
      "interval": 1,
      "format": "UK, {:%a %I:%M:%S%p}",
      "tooltip-format": "{:%H:%M:%S, %A, %e %B %Y}"
    },
    "clock#nl": {
      "timezone":"Europe/Amsterdam",
      "interval": 1,
      "format": "NL, {:%a %I:%M:%S%p}",
      "tooltip-format": "{:%H:%M:%S, %A, %e %B %Y}"
    },
    "clock#au": {
      "timezone":"Australia/Brisbane",
      "interval": 1,
      "format": "AU, {:%a %I:%M:%S%p}",
      "tooltip-format": "{:%H:%M:%S, %A, %e %B %Y}"
    },
    "memory": {
        "interval": 30,
        "format": " {}%",
        "tooltip-format": " {used:1.0f}G/{total:1.0f}G {swapUsed}G/{swapTotal}G"
    },
    "memory#icon": {
         "interval": 1,
         "format": "{icon}",
         "tooltip-format": " {used:1.0f}G/{total:1.0f}G {swapUsed}G/{swapTotal}G",
         "format-icons": [
              "<span color='#d0d1d1'>▁▁</span>",
              "<span color='#d0d1d1'>▂▂</span>",
              "<span color='#d0d1d1'>▃▃</span>",
              "<span color='#d0d1d1'>▄▄</span>",
              "<span color='#fbb750'>▅▅</span>",
              "<span color='#fbb750'>▆▆</span>",
              "<span color='#fda308'>▇▇</span>",
              "<span color='#de5d68'>██</span>" 
         ]
    },
    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "max-length": 10
    },
    "cpu#icon": {
         "interval": 1,
         "format": "{icon} ",
         "format-icons": [
              "<span color='#d0d1d1'>▁▁</span>",
              "<span color='#d0d1d1'>▂▂</span>",
              "<span color='#d0d1d1'>▃▃</span>",
              "<span color='#fbb750'>▄▄</span>",
              "<span color='#fbb750'>▅▅</span>",
              "<span color='#fda308'>▆▆</span>",
              "<span color='#de5d68'>▇▇</span>",
              "<span color='#de5d68'>██</span>" 
         ]
    },

    "clock": {
      "interval": 1,
      "format": " {:%a, %B, %d | %I:%M:%S%p}",
      "tooltip-format": "{:%H:%M:%S, %A, %e %B %Y}"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "custom/fullscreen": {
        "exec": "~/.config/waybar/fullscreen_status.sh",
        "interval": 1,
        "return-type": "json",
    },
}
